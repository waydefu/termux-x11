+struct p2a2_unw {
+    int n;
+};
+
+static _Unwind_Reason_Code
+p2a2_unw_cb(struct _Unwind_Context *ctx, void *arg)
+{
+    struct p2a2_unw *s = (struct p2a2_unw *) arg;
+    uintptr_t ip = _Unwind_GetIP(ctx);
+    Dl_info info;
+    const char *fname = "?";
+    const char *sname = "?";
+    uintptr_t off = 0;
+    char msg[512];
+
+    if (dladdr((void *) ip, &info)) {
+        if (info.dli_fname && info.dli_fname[0])
+            fname = info.dli_fname;
+        if (info.dli_sname) {
+            sname = info.dli_sname;
+            off = ip - (uintptr_t) info.dli_saddr;
+        }
+        else if (info.dli_fbase)
+            off = ip - (uintptr_t) info.dli_fbase;
+    }
+    snprintf(msg, sizeof(msg), "Sbt %u: %s (%s+0x%x) [%p]",
+             s->n, fname, sname, (int) off, (void *) ip);
+    p2a2_emit(msg);
+    ErrorFSigSafe("%u: %s (%s+0x%x) [%p]\n", s->n, fname, sname, (int) off,
+                  (void *) ip);
+    s->n++;
+    return s->n >= 64 ? _URC_END_OF_STACK : _URC_NO_REASON;
+}
+
+void
+xorg_backtrace(void)
+{
+    struct p2a2_unw s = { 0 };
+
+    p2a2_emit("Sbt Backtrace:");
+    ErrorFSigSafe("\nBacktrace:\n");
+    _Unwind_Backtrace(p2a2_unw_cb, &s);
+}
+
+#else
 /* Default fallback if we can't find any way to get a backtrace */
 void
 xorg_backtrace(void)
 {
     return;
 }
+#endif /* __ANDROID__ */
 
 #endif
 #endif
